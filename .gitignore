# Build artifacts -- never tracked, regenerated by scripts/build_release_bundle.py
build/
dist/
*.egg-info/
__pycache__/
*.pyc
*.whl

# Local environments
venv/
.venv/
.env

# Internal development material -- deliberately not part of this repo. The same boundary
# scripts/build_release_bundle.py already enforces for the release bundle (see its
# FORBIDDEN_NAMES / FORBIDDEN_PREFIXES): milestone logs, the working handoff doc, curated
# benchmark data and literature-compilation spreadsheets never leave the dev machine.
HANDOFF.md
MEMORY.md
MILESTONE_*.md
*_PREREGISTRATION.md
DEVELOPER.md
INSTALL.md
RELEASE.md
benchmark/
*.xlsx
settings.local.json

# Editor / OS noise
.DS_Store
Thumbs.db
